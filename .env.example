POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/db

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

OLLAMA_BASE_URL=http://ollama:11434
# Default is small + CPU-friendly so `docker compose up` works on any reviewer's
# machine, even without a GPU. Bump to a bigger model locally if you enable the
# GPU block in docker-compose.yml (see README).
OLLAMA_MODEL=phi4-mini:latest

# Comma-separated, case-insensitive. Used by the anomaly detector to flag
# USD-denominated transactions on merchants that are domestic-only brands.
DOMESTIC_ONLY_BRANDS=Swiggy,Ola,IRCTC,Zomato,RedBus,BookMyShow
